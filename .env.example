# JavaScript 키만 넣습니다. REST API 키는 여기서 쓰지 않습니다.
# 콘솔: 앱 > 플랫폼 키 > JavaScript 키 > JavaScript SDK 도메인
# 예: http://127.0.0.1:5174 와 http://localhost:5174 (http:// 포함)
# 링크 연동 허용 / 제품 링크 웹 도메인과는 다른 설정입니다.
# 카카오맵 > 사용 설정도 ON 이어야 합니다.
PUBLIC_KAKAO_JS_KEY=

# 서버 전용. 브라우저에 넣지 않습니다. PUBLIC_ 접두사 금지.
# 카카오맵 REST API 키. 대중교통 경로 조회(publictraffic)에 씁니다.
# 없으면 Mock 경로를 씁니다. JavaScript 키와는 별개입니다.
KAKAO_REST_API_KEY=

# 압축 푼 GTFS 폴더. 없으면 퇴근각은 20분 추정 배차입니다.
# zip은 직접 풀고 이 경로만 가리킵니다. 저장소에 전국 피드를 넣지 마세요.
# 상대 경로면 개발 서버를 켠 폴더 기준입니다. 안 읽히면 절대 경로를 쓰세요.
GTFS_DIR=./data/gtfs
