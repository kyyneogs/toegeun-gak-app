# JavaScript 키만 넣습니다. REST API 키는 여기서 쓰지 않습니다.
# 콘솔: 앱 > 플랫폼 키 > JavaScript 키 > JavaScript SDK 도메인
# 예: http://127.0.0.1:5174 와 http://localhost:5174 (http:// 포함)
# 배포: https://your-app.vercel.app 와 실제 도메인. 와일드카드가 안 되면 URL을 각각 등록합니다.
# 링크 연동 허용 / 제품 링크 웹 도메인과는 다른 설정입니다.
# 카카오맵 > 사용 설정도 ON 이어야 합니다.
PUBLIC_KAKAO_JS_KEY=

# 서버 전용. 브라우저에 넣지 않습니다. PUBLIC_ 접두사 금지.
# 카카오맵 REST API 키. 대중교통 경로 조회(publictraffic)에 씁니다.
# 없으면 Mock 경로를 씁니다. JavaScript 키와는 별개입니다.
KAKAO_REST_API_KEY=

# 로컬 파일 시각표. 기본은 서울·성남 슬라이스입니다.
# 전체 피드는 ./data/gtfs, 슬라이스 재생성은 npm run gtfs:filter-seoul-seongnam
# Vercel 프로덕션에는 넣지 마세요.
GTFS_DIR=./data/gtfs-seoul-seongnam

# 로컬에 없으면 PGlite(.data/pglite). 테스트는 메모리 DB.
# Vercel·슬라이스 적재는 Postgres 연결 문자열이 필수입니다. PUBLIC_ 접두사 금지.
# https://xxxx.supabase.co 가 아닙니다. Settings > Database 의 postgresql:// URI 입니다.
DATABASE_URL=

# 웹 푸시. 없으면 개발에서만 임시 키를 만듭니다. 프로덕션은 필수입니다.
# 공개키는 /api/push/vapid 로만 내려 주세요. PRIVATE 키는 PUBLIC_ 금지.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@localhost

# Vercel Cron. Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
